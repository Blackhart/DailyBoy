# Rocky Linux 9 — packages shared by all VFX platform year images.
# Toolchain (gcc-toolset / Python) lives in Dockerfile.rocky9.cy202*.

# ---------------------------------------------------------------------------
# Base image
# ---------------------------------------------------------------------------
FROM rockylinux:9

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENV CMAKE_GENERATOR=Ninja \
    CCACHE_DIR=/ccache

# ---------------------------------------------------------------------------
# DNF: EPEL + CRB
# ---------------------------------------------------------------------------
RUN dnf -y install dnf-plugins-core epel-release \
    && dnf -y config-manager --set-enabled crb \
    && dnf -y update \
    && dnf clean all

# ---------------------------------------------------------------------------
# Build tools
# ---------------------------------------------------------------------------
RUN dnf -y install \
        autoconf \
        automake \
        ca-certificates \
        ccache \
        file \
        git \
        libtool \
        make \
        nasm \
        ninja-build \
        pkgconf-pkg-config \
        wget \
        which \
        xz \
    && dnf clean all

# ---------------------------------------------------------------------------
# Libraries (OpenSSL, zlib, uuid, FreeType)
# ---------------------------------------------------------------------------
RUN dnf -y install \
        freetype-devel \
        libuuid-devel \
        openssl-devel \
        zlib-devel \
    && dnf clean all

# ---------------------------------------------------------------------------
# Fonts (DejaVu)
# RPM layout differs from Debian/Ubuntu. Unit tests, perf jobs, and example
# YAMLs hardcode /usr/share/fonts/truetype/dejavu/*.ttf — symlink so those
# paths resolve on Rocky without rewriting every fixture.
# ---------------------------------------------------------------------------
RUN dnf -y install \
        dejavu-sans-fonts \
        dejavu-sans-mono-fonts \
    && mkdir -p /usr/share/fonts/truetype/dejavu \
    && ln -sf /usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf \
        /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
    && ln -sf /usr/share/fonts/dejavu-sans-fonts/DejaVuSans-Bold.ttf \
        /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf \
    && ln -sf /usr/share/fonts/dejavu-sans-mono-fonts/DejaVuSansMono.ttf \
        /usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf \
    && dnf clean all \
    && test -f /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# ---------------------------------------------------------------------------
# CMake ≥ 3.28 (Kitware binary — stock RPM is too old)
# ---------------------------------------------------------------------------
RUN CMAKE_VERSION=3.28.6 \
    && curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
        | tar -xz -C /usr/local --strip-components=1 \
    && cmake --version | grep -E 'cmake version 3\.(2[8-9]|[3-9][0-9])'

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------
WORKDIR /src
