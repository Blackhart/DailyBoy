# Ubuntu 24.04 — packages shared by all VFX platform year images.
# Toolchain (gcc / Python) lives in Dockerfile.ubuntu24.cy202*.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    CMAKE_GENERATOR=Ninja \
    CCACHE_DIR=/ccache

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        software-properties-common \
        autoconf \
        automake \
        build-essential \
        ccache \
        clang-format \
        clang-tidy \
        cmake \
        gcovr \
        git \
        fonts-dejavu-core \
        libfreetype6-dev \
        libssl-dev \
        libtool \
        nasm \
        ninja-build \
        pkg-config \
        uuid-dev \
        wget \
        xz-utils \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
